---
import '../styles/custom.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const { title = 'TEP', description = 'News and announcements from Urth, Valsora and The East Pacific.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f2f0" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a1a" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <script is:inline>
    // Set the initial color theme before first paint: stored manual override
    // or the OS color scheme (auto). Shares the `starlight-theme` key with
    // Starlight docs pages so the choice stays in sync across the site.
    try {
      var storedTheme = localStorage.getItem('starlight-theme');
      document.documentElement.dataset.theme =
        storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
    } catch (e) {
      document.documentElement.dataset.theme = 'dark';
    }
  </script>
</head>
<body>
  <SiteHeader currentPath={currentPath} />
  
  <main class="site-main">
    <slot />
  </main>
  
  <SiteFooter />
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  
  body {
    background: var(--tep-dark);
    color: var(--tep-light);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .site-main {
    flex: 1;
    width: 100%;
  }
</style>
