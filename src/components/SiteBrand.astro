---
import logo from '../assets/logo.svg';

// Shared site brand, rendered identically in both the docs header
// (Starlight pages) and the blog-post header (SiteHeader).
---
<a href="/" class="brand">
  <img src={logo.src} width={logo.width} height={logo.height} alt="The East Pacific logo" class="brand-logo" />
  <span class="brand-text">TEP</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--tep-light);
    font-weight: 700;
  }

  :global([data-theme='light']) .brand {
    color: #1a1418;
  }

  .brand-logo {
    height: 2rem;
    width: auto;
    display: block;
  }

  .brand-text {
    /* Climate Crisis is the TEP display font (caps only). */
    font-family: 'Climate Crisis', display;
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .brand-text {
      font-size: 0.95rem;
    }
  }
</style>