---
import DiscourseComments from './DiscourseComments.astro';

// Renders a single blog post with the demo-exact Discourse embed
// (discourseEmbedUrl + full app + dynamic height bounds).
// embedUrl: canonical page URL — this is what resolves the forum topic.
const { frontmatter, embedUrl } = Astro.props;

function formatDate(value) {
  if (!value) return '';
  const d = value instanceof Date ? value : new Date(value);
  if (isNaN(d)) return String(value);
  // Dates in post frontmatter are date-only, parsed as UTC midnight — format in
  // UTC so they never shift a day in any timezone.
  return d.toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
  });
}

const replyCount = Number.isInteger(frontmatter?.replies) ? frontmatter.replies : 0;
---
<article class="blog-post">
  <header class="post-header">
    <h1>{frontmatter.title}</h1>
    <div class="post-meta">
      <span>By <strong>{frontmatter.author}</strong></span>
      <span>·</span>
<span>{formatDate(frontmatter.pubDate || frontmatter.date)}</span>
    </div>
  </header>

  <div class="post-content">
    <slot />
  </div>

  {embedUrl && (
    <section class="post-comments" aria-label="Comments">
      <div class="comments-head">
        <h2>
          Comments
          {replyCount > 0 && <span class="comments-count">{replyCount}</span>}
        </h2>
        {frontmatter.discourseUrl && (
          <a
            class="comments-link"
            href={frontmatter.discourseUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Continue on the forum <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      <DiscourseComments embedUrl={embedUrl} className="tep-comments" />
    </section>
  )}
</article>

<style>
  .blog-post {
    max-width: 720px;
    margin: 0 auto;
    font-family: var(--font-body);
  }
  
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(242, 242, 240, 0.08);
  }
  :global([data-theme='light']) .post-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .post-header h1 {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    letter-spacing: -0.025em;
  }
  .post-meta {
    display: flex;
    gap: 0.5rem;
    color: var(--tep-muted);
    font-size: 0.9rem;
    font-family: var(--font-body);
    font-weight: 500;
  }
  .post-content {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    font-weight: 400;
  }
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .post-content :global(p) {
    margin: 1.25rem 0;
  }
  .post-content :global(a) {
    color: var(--tep-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .post-content :global(a):hover {
    color: var(--tep-yellow);
  }
  :global([data-theme='light']) .post-content :global(a) {
    color: var(--tep-green);
  }
  :global([data-theme='light']) .post-content :global(a):hover {
    color: var(--tep-green-light);
  }
  .post-comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(242, 242, 240, 0.08);
  }
  :global([data-theme='light']) .post-comments {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .comments-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .comments-head h2 {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .comments-count {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(242, 242, 240, 0.06);
    border: 1px solid rgba(242, 242, 240, 0.1);
    color: var(--tep-dim);
  }
  :global([data-theme='light']) .comments-count {
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .comments-link {
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tep-teal);
    text-decoration: none;
    transition: color 0.2s;
  }
  .comments-link:hover {
    color: var(--tep-yellow);
  }
  :global([data-theme='light']) .comments-link {
    color: var(--tep-green);
  }
  :global([data-theme='light']) .comments-link:hover {
    color: var(--tep-green-light);
  }
  .post-comments :global(#discourse-comments) {
    min-height: 200px;
  }
  /* The embedded forum thread brings its own (forum-styled) background, so
     frame it deliberately on both themes. */
  .post-comments :global(iframe) {
    width: 100%;
    border: 1px solid rgba(242, 242, 240, 0.08);
    border-radius: 14px;
    background: #1a1a1a;
  }
  :global([data-theme='light']) .post-comments :global(iframe) {
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #ffffff;
  }
</style>
