---
// Discourse embed for the forum-first workflow: topics are created on the
// forum, synced to the site as news by scripts/sync-discourse.mjs, and the
// embed links each page back to its existing topic.
//
// This is the documented "Alternate Configuration: Linking to existing
// topics" (https://meta.discourse.org/t/31963): with topicId the embed shows
// that topic's comments and NEVER creates topics, so duplicates are
// impossible by construction — including for future posts, which the sync
// picks up with their IDs automatically.
//
// Sizing mirrors the official demo
// (https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/):
// dynamic height bounded by min/max instead of a rigid box. fullApp is
// intentionally off: it renders the whole forum page when combined with
// topicId (known upstream flakiness), while the classic view trims to the
// discussion. Visitors reply via "Continue on the forum".
//
// Requires Admin > Customize > Embedding on the forum to allow-list
// `theeastpacific.com` as an Embeddable Host.
interface Props {
  /** Existing Discourse topic id (preferred — shows current replies) */
  topicId?: number;
  /** Canonical URL of this page (fallback; may auto-create a topic) */
  embedUrl?: string;
  /** Base URL of the Discourse forum, with trailing slash */
  discourseUrl?: string;
  /** Optional class added to the embed iframe wrapper */
  className?: string;
}

const {
  topicId,
  embedUrl,
  discourseUrl = 'https://forum.theeastpacific.com/',
  className,
} = Astro.props;
---
<div id="discourse-comments"></div>

<script
  is:inline
  type="text/javascript"
  define:vars={{ discourseUrl, embedUrl, topicId, className }}
>
  // Prefer topicId (existing topic, never creates anything) — otherwise fall
  // back to embed URL mode.
  var baseEmbed = {
    discourseUrl: discourseUrl,
    dynamicHeight: true,
    embedMinHeight: '500',
    embedMaxHeight: '1600',
    embedHeight: '800px',
    ...(className ? { className } : {}),
  };
  window.DiscourseEmbed = Number.isInteger(topicId)
    ? { ...baseEmbed, topicId: topicId }
    : { ...baseEmbed, discourseEmbedUrl: embedUrl };

  (function () {
    var d = document.createElement('script');
    d.type = 'text/javascript';
    d.async = true;
    d.src = window.DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
    (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(d);
  })();
</script>

<noscript>
  <p>
    Please enable JavaScript to view the comments, or
    <a href={discourseUrl} target="_blank" rel="noopener noreferrer">visit the forum</a>.
  </p>
</noscript>
