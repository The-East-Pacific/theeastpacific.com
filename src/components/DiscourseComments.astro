---
// Discourse embed, mirroring the official demo exactly:
// https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/
// (specs: https://meta.discourse.org/t/31963 and
// https://meta.discourse.org/t/399743)
//
// Demo-exact config: discourseEmbedUrl + fullApp + dynamic height bounds.
// We intentionally do NOT send topicId: with full app mode it makes the
// iframe render the whole forum page instead of the trimmed embed view.
// Topic resolution therefore happens via the canonical page URL, exactly
// like the demo.
//
// IMPORTANT forum-side setup (otherwise topics duplicate or won't load):
// - Admin > Customize > Embedding allow-lists `theeastpacific.com`.
// - Admin > Advanced > Embedding enables full app mode (`embed_full_app`).
// - Existing topics must be linked to their page URLs first, or the first
//   visit auto-creates a DUPLICATE topic. In a Rails console on the forum:
//     TopicEmbed.find_or_create_by!(embed_url: 'https://theeastpacific.com/blog/<slug>/', topic_id: <id>)
interface Props {
  /** Canonical URL of this page, e.g. https://theeastpacific.com/blog/my-post/ */
  embedUrl: string;
  /** Base URL of the Discourse forum, with trailing slash */
  discourseUrl?: string;
  /** Optional class added to the embed iframe wrapper */
  className?: string;
}

const {
  embedUrl,
  discourseUrl = 'https://forum.theeastpacific.com/',
  className,
} = Astro.props;
---
<div id="discourse-comments"></div>

<script
  is:inline
  type="text/javascript"
  define:vars={{ discourseUrl, embedUrl, className }}
>
  window.DiscourseEmbed = {
    discourseUrl: discourseUrl,
    discourseEmbedUrl: embedUrl,
    fullApp: true,
    dynamicHeight: true,
    embedMinHeight: '500',
    embedMaxHeight: '1600',
    embedHeight: '800px',
    ...(className ? { className } : {}),
  };

  (function () {
    var d = document.createElement('script');
    d.type = 'text/javascript';
    d.async = true;
    d.src = window.DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
    (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(d);
  })();
</script>

<noscript>
  <p>
    Please enable JavaScript to view the comments, or
    <a href={discourseUrl} target="_blank" rel="noopener noreferrer">visit the forum</a>.
  </p>
</noscript>
