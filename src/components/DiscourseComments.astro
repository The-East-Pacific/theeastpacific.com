---
// Full Discourse comment embed per official spec:
// https://meta.discourse.org/t/embed-discourse-comments-on-another-website-via-javascript/31963
//
// Two modes (spec supports both):
// - topicId: links embed to an EXISTING forum topic. Use this when the page
//   was synced from the forum (we know discourseId). Shows existing replies.
// - discourseEmbedUrl: canonical page URL, Discourse auto-creates/finds the
//   linked topic. Fallback for pages without a known topic id.
//
// NOTE on rendering mode: the official demo
// (https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/)
// pairs "full app mode" (https://meta.discourse.org/t/399743 — interactive
// reply/like/quote inside the page) with dynamic height bounds, and that is
// what we mirror here. Full app alone in a rigid fixed-height box looks
// wrong; dynamicHeight lets the frame fit its content between min and max.
//
// Requires Admin > Customize > Embedding on the forum to allow-list
// `theeastpacific.com` as an Embeddable Host.
interface Props {
  /** Existing Discourse topic id (preferred — shows current replies) */
  topicId?: number;
  /** Canonical URL of this page, e.g. https://theeastpacific.com/blog/my-post/ */
  embedUrl?: string;
  /** Base URL of the Discourse forum, with trailing slash */
  discourseUrl?: string;
  /** Optional class added to the embed iframe wrapper */
  className?: string;
}

const {
  topicId,
  embedUrl,
  discourseUrl = 'https://forum.theeastpacific.com/',
  className,
} = Astro.props;
---
<div id="discourse-comments"></div>

<script
  is:inline
  type="text/javascript"
  define:vars={{ discourseUrl, embedUrl, topicId, className }}
>
  // Prefer topicId (existing topic) — otherwise fall back to embed URL mode.
  // fullApp + dynamic height bounds mirror the official demo exactly; the
  // topicId (vs the demo's discourseEmbedUrl) only changes WHICH topic
  // resolves, and keeps us from spawning duplicate topics for pages the
  // forum already has. Requires the forum's `embed_full_app` toggle on.
  var baseEmbed = {
    discourseUrl: discourseUrl,
    fullApp: true,
    dynamicHeight: true,
    embedMinHeight: '500',
    embedMaxHeight: '1600',
    embedHeight: '800px',
    ...(className ? { className } : {}),
  };
  window.DiscourseEmbed = Number.isInteger(topicId)
    ? { ...baseEmbed, topicId: topicId }
    : { ...baseEmbed, discourseEmbedUrl: embedUrl };

  (function () {
    var d = document.createElement('script');
    d.type = 'text/javascript';
    d.async = true;
    d.src = window.DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
    (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(d);
  })();
</script>

<noscript>
  <p>
    Please enable JavaScript to view the comments, or
    <a href={discourseUrl} target="_blank" rel="noopener noreferrer">visit the forum</a>.
  </p>
</noscript>
